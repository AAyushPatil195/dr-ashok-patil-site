# Public canonical origin. Local development only; do not import this localhost
# value into Netlify. For staging use https://<project-name>.netlify.app;
# after the domain is connected and HTTPS works use https://drashokpatil.in.
# Netlify previews use DEPLOY_PRIME_URL automatically, overriding this value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep indexing disabled until production content is launch-ready.
# Public URL/indexing changes require a new build. Previews stay noindex.
NEXT_PUBLIC_SITE_INDEXING_ENABLED=false

# Resend configuration for the appointment / enquiry form.
# The sender must use a domain verified in the Resend account.
# Server-only: configure through Netlify's UI, including Functions scope.
# Use a separate test recipient/key for previews; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
ENQUIRY_EMAIL_FROM=
ENQUIRY_EMAIL_TO=
